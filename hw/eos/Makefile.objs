# Paths are relative ../arm
obj-y += ../eos/eos.o ../eos/model_list.o ../eos/engine.o ../eos/capture.o
obj-y += ../eos/eos_ml_helpers.o ../eos/mpu.o ../eos/serial_flash.o
obj-y += ../eos/dbi/logging.o ../eos/dbi/memcheck.o ../eos/dbi/debugmsg.o
obj-y += ../eos/dbi/backtrace.o
obj-y += ../eos/scnprintf.o ../eos/lv_inject.o ../eos/eeko.o

# Camera profiles (docs/models/PROFILES.md): every .c in hw/eos/cams/<CAM>/ is built, except the
# model table entry model.inc.c (included by model_list.c), so a new profile needs no edit here.
eos-cam-srcs := $(filter-out %.inc.c,$(wildcard $(SRC_PATH)/hw/eos/cams/*/*.c))
obj-y += $(patsubst $(SRC_PATH)/hw/eos/%.c,../eos/%.o,$(eos-cam-srcs))
