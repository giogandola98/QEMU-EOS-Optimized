# QEMU-EOS-Optimized built headless from THIS repository (context = repo root, see .containerignore).
# Build:  podman build --network=host -t qemu-eos-base -f ci/qemu/Containerfile .
# Then ci/qemu/Containerfile.tools adds the TCG plugins on top (published image, see docs/PERFORMANCE.md).
#
# Contents (/opt/qemu-eos):
#   bin/qemu-system-arm, bin/qemu-img     arm-softmmu with TCG plugins and VNC, no GUI toolkit
#   plugins/libmagiclantern.so            upstream plugin behind `-d debugmsg` (DryosDebugMsg logging)
#   include/qemu-plugin.h                 plugin API header
#   magiclantern/                         upstream ML QEMU tooling (ml_qemu/run.py, cam_config, ml_tests, sd.qcow2.xz)
#   BUILD_PROFILE                         configure profile used (see QEMU_PROFILE below)
# plus gcc (plugins), binutils-arm-none-eabi (bare-metal self-test), mtools (SD image), python3-pil (screenshots).
FROM docker.io/library/debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8 AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential python3 pkg-config flex bison \
      libglib2.0-dev libpixman-1-dev libfdt-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

# QEMU_PROFILE selects the configure flags:
#   baseline  exactly what ML-Optimized's in-tree image used (QEMU defaults: -O2 -g), the phase-1 reference
ARG QEMU_PROFILE=baseline

COPY . /src/qemu-eos

# No .git in the context, so configure takes the tree as a release tarball (no submodule fetches;
# ui/keycodemapdb is vendored). System libfdt replaces the dtc submodule; slirp/capstone are not needed
# (no guest network, no disassembler). QEMU 4.2 predates GCC 12: --disable-werror keeps new warnings from
# failing the build. Do not add -fcommon: vl.c's tentative definitions would then pull
# stubs/machine-init-done.o in and collide.
WORKDIR /src/build
RUN set -e; \
    common="--prefix=/opt/qemu-eos --target-list=arm-softmmu \
      --enable-plugins --enable-vnc --enable-fdt --disable-docs --disable-werror \
      --disable-gtk --disable-sdl --disable-vte --disable-curses --disable-opengl \
      --disable-slirp --disable-capstone --disable-libusb --disable-usb-redir \
      --disable-spice --disable-xen --disable-guest-agent"; \
    case "$QEMU_PROFILE" in \
      baseline) ../qemu-eos/configure $common ;; \
      *) echo "unknown QEMU_PROFILE $QEMU_PROFILE" >&2; exit 1 ;; \
    esac; \
    make -j"$(nproc)"; \
    make plugins; \
    mkdir -p /opt/qemu-eos/bin /opt/qemu-eos/plugins /opt/qemu-eos/include; \
    cp arm-softmmu/qemu-system-arm qemu-img /opt/qemu-eos/bin/; \
    cp tests/plugin/libmagiclantern.so /opt/qemu-eos/plugins/; \
    cp ../qemu-eos/include/qemu/qemu-plugin.h /opt/qemu-eos/include/; \
    cp -r ../qemu-eos/magiclantern /opt/qemu-eos/magiclantern; \
    echo "$QEMU_PROFILE" > /opt/qemu-eos/BUILD_PROFILE; \
    strip /opt/qemu-eos/bin/*


FROM docker.io/library/debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

# Runtime libs of qemu-system-arm, plus the job-time tools listed at the top.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libglib2.0-0 libpixman-1-0 libfdt1 zlib1g \
      gcc libc6-dev binutils-arm-none-eabi \
      python3 python3-pil mtools xz-utils ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/qemu-eos /opt/qemu-eos
ENV PATH=/opt/qemu-eos/bin:$PATH
ENV QEMU_EOS=/opt/qemu-eos

# Fail the image build, not a later job, if QEMU cannot start.
RUN qemu-system-arm --version && qemu-system-arm -M help | grep -qw EOSM

WORKDIR /work
